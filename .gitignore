# ==============================================================================
# SmartSpend AI — Comprehensive .gitignore
# Stack: React + Vite, Flask, SQLite, scikit-learn, pytest
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 2. Node.js & Vite Frontend
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Automated Testing & Code Quality Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------------------------
# 4. Sensitive Environment & Configuration Files
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 5. Local State & Database Files
# ------------------------------------------------------------------------------
# Exclude stateful SQLite databases that mutate at runtime
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# Explicitly preserve the static benchmark dataset and trained ML model artifacts
!data/expenses_dataset.csv
!data/models/
!data/models/*.joblib
!data/models/*.npy

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
