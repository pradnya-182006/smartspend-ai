# ==============================================================================
# SmartSpend AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your local or production setup.
# IMPORTANT: Never commit .env or real secret keys to public source control.
# ==============================================================================

# Flask Session Secret Key (Must be set to a secure, random string in production)
SMARTSPEND_SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-min

# Backend Server Port (Default: 5000)
PORT=5000

# Flask Debug Mode (0 for production/demo, 1 for development)
FLASK_DEBUG=0

# SQLite Database File Path (Optional override)
# If left commented, defaults automatically to data/smartspend.db
# SMARTSPEND_DB_PATH=data/smartspend.db
